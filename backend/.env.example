# ancu365 backend — environment variables template
# Usage: cp .env.example .env  → edit passwords → docker compose up -d
# NEVER commit .env to git (it contains secrets).

# ── App ────────────────────────────────────────────────────────────────────────
PORT=3000
APP_BASE_URL=http://localhost:3000

# Tài khoản doanh nghiệp nhận 50% cọc nền tảng. Để trống cho tới khi kế toán
# cung cấp tài khoản thật; API sẽ trả is_configured=false.
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NUMBER=
PLATFORM_BANK_ACCOUNT_HOLDER=
PLATFORM_BANK_TRANSFER_PREFIX=ANCU
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=please_rotate_in_prod_32_chars_min
TOKEN_TTL_HOURS=168
UPLOAD_DIR=./uploads
BACKEND_CORS_ORIGINS=*

# ── Activity / Management v2 rollout ─────────────────────────────────────────
# Mặc định tắt: deploy schema/code không tự thay UI hay command đang chạy.
# Bật read trước, đối chiếu shadow-read, rồi mới bật write theo cohort/cụm.
MANAGEMENT_V2_ENABLED=false
MANAGEMENT_V2_WRITES_ENABLED=false
MANAGEMENT_V2_COHORT_USER_IDS=
VIEWING_V2_ENABLED=false
VIEWING_V2_WRITES_ENABLED=false
SALE_CRM_V2_ENABLED=false
SALE_CRM_V2_WRITES_ENABLED=false
STAY_V2_ENABLED=false
STAY_V2_WRITES_ENABLED=false
MONEY_LEDGER_V2_ENABLED=false
SHORT_STAY_INVENTORY_V2_ENABLED=false
BUY_SELL_V2_ENABLED=false

# ── Database (Postgres + PostGIS) ─────────────────────────────────────────────
# Phase 01: SQLite removed. Postgres is the only supported DB.
# Docker (inside container network): use hostname "postgis"
DATABASE_URL=postgresql://ancu365:change_me_strong_64_chars@postgis:5432/ancu365
# Local dev (running uvicorn directly on host, not in Docker): use localhost
# DATABASE_URL=postgresql://ancu365:change_me_strong_64_chars@localhost:5432/ancu365
POSTGRES_USER=ancu365
POSTGRES_PASSWORD=change_me_strong_64_chars
POSTGRES_DB=ancu365

# ── Planning ETL ───────────────────────────────────────────────────────────────
# WFS public endpoint (no auth needed)
WFS_BASE_URL=https://geodata-stnmt.tphcm.gov.vn/geoserver/ows
ETL_CONTACT_EMAIL=ops@ancu365.vn
# Override ETL DB if different from main DATABASE_URL (optional; leave empty to use DATABASE_URL)
PLANNING_DATABASE_URL=

# ── Martin tile server ─────────────────────────────────────────────────────────
# MARTIN_URL used by backend for server-side tile requests (internal Docker network)
MARTIN_URL=http://martin:3000
# MARTIN_PUBLIC_URL used by Flutter clients (exposed host port)
MARTIN_PUBLIC_URL=http://localhost:3001

# ── Nominatim reverse geocoding ────────────────────────────────────────────────
NOMINATIM_URL=http://nominatim:8080
# Password for Nominatim's internal Postgres (only used during Nominatim import)
NOMINATIM_PASSWORD=change_me_nominatim
# OSM PBF download URL (override for faster mirror if needed)
PBF_URL=https://download.geofabrik.de/asia/vietnam-latest.osm.pbf

# ============ Production ============
# Set these when deploying to VPS. Never commit real values.
# Usage: copy this file to .env, fill in each value, chmod 600 .env

# === Production (set when deploying to VPS) ===
# Domain without protocol/trailing slash, e.g. ancu365.vn
ANCU_DOMAIN=ancu365.vn
ENVIRONMENT=production
BACKEND_CORS_ORIGINS=["https://ancu365.vn"]
# Enable APScheduler daily ETL cron (2 AM ICT) inside backend container
CRON_ENABLED=1

# Backup (Backblaze B2)
# Create a key at https://www.backblaze.com/b2/app-keys.html
# Key must have: read + write + deleteFiles on the bucket
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=ancu365-backups

# Notifications (ntfy — self-hosted or ntfy.sh public)
# Topic name only, not the full URL; backup.sh constructs the URL.
NTFY_TOPIC=ancu365-alerts
# Optional: self-hosted ntfy base URL (defaults to https://ntfy.sh if unset)
NTFY_URL=https://ntfy.sh

# ── Firebase Cloud Messaging ─────────────────────────────────────────────────
# Default "stub" keeps local/dev safe. Set "firebase" after mounting the service
# account JSON into the backend container. Never commit the JSON key.
NOTIFICATION_PUSH_PROVIDER=stub
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/ancu365-firebase-adminsdk.json

# ── Observability / self-heal pipeline ─────────────────────────────────────────
# Thư mục ghi structured log (JSONL). Nên mount ra host để pipeline đọc được.
LOG_DIR=./storage/logs
LOG_LEVEL=INFO
# Salt hash user-id trong log (KHÔNG lưu id thô). ĐỔI giá trị này ở prod.
LOG_HASH_SALT=change-me-log-salt
# Bật/tắt endpoint nhận crash từ Flutter (/api/client-logs).
CLIENT_LOGS_ENABLED=true

# Trang web nộp hồ sơ Sale. App chỉ mở ticket một lần trong URL fragment, không JWT.
SALE_APPLICATION_WEB_URL=https://your-web-domain.example/tro-thanh-sale

# Báo yêu cầu dịch vụ cho admin qua Telegram (tuỳ chọn — rỗng = tắt).
# Lấy token từ @BotFather, chat_id từ @userinfobot sau khi nhắn cho bot 1 lần.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Quy hoạch: 1 = chỉ đọc kho tile local, không bao giờ gọi CDN Guland.
PLANNING_TILES_LOCAL_ONLY=1
