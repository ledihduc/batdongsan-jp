# env.jp.template — JP market environment variable template.
#
# Copy this to .env.jp on the deployment host and fill in all values.
# NEVER commit a filled .env.jp to git.
#
# Usage:
#   cp deploy/jp/env.jp.template .env.jp
#   # Fill in all values, then:
#   docker compose --env-file .env.jp -f docker-compose.prod.yml -f deploy/jp/docker-compose.jp.yml up -d

# ── Region ────────────────────────────────────────────────────────────────────
# Must be 'jp' — activates JP cron, JP routes, disables VN-only routes.
REGION=jp
DEFAULT_TZ=Asia/Tokyo

# ── Database (Tokyo RDS) ──────────────────────────────────────────────────────
# RDS PostgreSQL endpoint in ap-northeast-1.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
TOKYO_RDS_HOST=ancu365-jp.<cluster-id>.ap-northeast-1.rds.amazonaws.com
TOKYO_RDS_PORT=5432
TOKYO_RDS_DB=ancu365_jp
TOKYO_RDS_USER=ancu365_app
TOKYO_RDS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Assembled URL (used by DATABASE_URL in docker-compose.jp.yml):
TOKYO_RDS_URL=postgresql://${TOKYO_RDS_USER}:${TOKYO_RDS_PASSWORD}@${TOKYO_RDS_HOST}:${TOKYO_RDS_PORT}/${TOKYO_RDS_DB}

# ── JWT ───────────────────────────────────────────────────────────────────────
# Min 32 chars, randomly generated. Rotate via key rotation runbook.
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# ── PII Encryption (Fernet) ───────────────────────────────────────────────────
# Fernet key for field-level encryption of PII (ip_address, user_agent in jp_user_consents).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: see runbook-tokyo-deploy.md → "PII Key Rotation" section.
JP_FERNET_KEY=REPLACE_WITH_FERNET_KEY

# ── Multi-org HMAC Webhook ────────────────────────────────────────────────────
# Shared seed used to derive per-org HMAC secrets for webhook verification.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JP_HMAC_SECRET_SEED=REPLACE_WITH_32_BYTE_HEX_SECRET

# ── Geocoding (Nominatim) ─────────────────────────────────────────────────────
# User-Agent string required by OpenStreetMap Nominatim usage policy.
# Format: <app-name>/<version> (<contact-email>)
NOMINATIM_UA=ancu365-jp/1.0 (contact@ancu365.jp)

# ── App image ─────────────────────────────────────────────────────────────────
# Tag of the JP backend Docker image. Set by CI/CD pipeline.
JP_IMAGE_TAG=ancu365-backend:jp-latest

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Optional: Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ── Feature flags ────────────────────────────────────────────────────────────
# Planning module uses PostGIS — not available in JP stack.
PLANNING_ENABLED=false
# Social features (VN-only for now)
SOCIAL_ENABLED=false

# ── Upload storage ────────────────────────────────────────────────────────────
# Absolute path inside container where uploads are stored.
UPLOAD_DIR=/app/uploads

# ── External providers (sandbox mode for staging; set is_sandbox=False in DB for prod) ──
# Komoju (payment): credentials stored encrypted in org_provider_configs table.
# CloudSign (eSign): credentials stored encrypted in org_provider_configs table.
# Never store provider API keys here — use org_provider_configs with Fernet encryption.
